# Copie para .env na raiz do projeto antes de executar o Docker Compose.
# Gere segredos próprios com: openssl rand -hex 32
# Os valores abaixo são apenas exemplos e NÃO devem ser usados em produção.

JWT_SECRET=b7d1f0c9e4a8426f9c3d5e8a1b2c4d6f8e0a2c4e6f8a0b2d4c6e8f0a2b4c6d8e
JWT_REFRESH_SECRET=a1c3e5f7092b4d6f8a0c2e4f6a8b0d2f4c6e8a0b2d4f6a8c0e2f4a6b8d0c2e4f

# Porta pública do front (Nginx)
WEB_PORT=8080

# Origem usada pelo navegador; deve corresponder à porta acima
CORS_ORIGIN=http://localhost:8080

# Popula o banco de demonstração apenas quando ele está vazio
SEED_ON_START=true

# Opcionais
LOG_LEVEL=info
TRUST_PROXY=1
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
RATE_LIMIT_MAX=300
