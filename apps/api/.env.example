# Copie para .env e ajuste os valores. Nunca comite o .env.
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Quantidade de proxies reversos confiáveis (1 = nginx/traefik na frente da API).
TRUST_PROXY=1

# Segredos com no mínimo 32 caracteres e diferentes entre si.
# Em produção, gere com: openssl rand -hex 32
JWT_SECRET=ceramix-dev-secret-troque-em-producao-32
JWT_REFRESH_SECRET=ceramix-dev-refresh-troque-em-producao-32
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Origens permitidas separadas por vírgula (o Vite usa http://localhost:5173).
CORS_ORIGIN=http://localhost:5173

# Caminho relativo a apps/api ou absoluto.
DB_PATH=./data/ceramix.db

# Limite de requisições por minuto por IP.
RATE_LIMIT_MAX=300
